.DS_Store
**/.DS_Store
__pycache__/
*.pyc
outputs/ocr/.venv/
outputs/ocr/pages/*/_page_pdf_parts/
outputs/ocr/pages/*sample_pipeline/
outputs/ocr/pages/smoke_test/
outputs/ocr/pdf/*sample*.pdf
outputs/ocr/pdf/smoke_test.pdf

# Security - never commit
.env
*.key
*accesskey*

# Source PDFs - too large, keep out of git
*.pdf
!docmind_ocr_trial/input_samples/*.pdf
!docmind_ocr_full/chunks/**/*.pdf
